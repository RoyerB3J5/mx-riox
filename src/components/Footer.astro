---
import { Icon } from 'astro-icon/components';

type Translations = typeof import('../i18n/en').default;
type FooterContent = Translations['footer'];
interface Props {
  content?: FooterContent;
}
const { content } = Astro.props as Props;
const icons = [
  {
    name: 'email',
    href: 'https://mail.google.com/mail/?view=cm&fs=1&to=mgrioxplumbing@gmail.com',
  },
  /*{
    name: 'map',
    href: '',
  },*/
  {
    name: 'instagram',
    href: 'https://www.instagram.com/mgrioxplumbing/',
  },
  {
    name: 'facebook',
    href: 'https://www.facebook.com/mgrioxplumbing/',
  },
];
const currentPath = Astro.url.pathname;
const normalized = currentPath.replace(/^\/(en|es)/, '') || '/';
// Detectar el idioma actual ('en' o 'es')
const match = currentPath.match(/^\/(en|es)/);
const lang = match ? match[1] : 'en';
---

<footer class="flex flex-col justify-center items-center w-full">
  <div
    class="w-full flex flex-col lg:flex-row justify-center lg:justify-between items-center lg:items-start max-w-screen lg:max-w-7xl px-5 lg:px-0 py-12 lg:py-14.25 gap-9 lg:gap-4 min-h-none lg:min-h-109.5"
  >
    <a href="/" class="block">
      <img
        src="/logo-black.webp"
        alt="Logo de Mg Riox Plumbing"
        width="1300"
        height="728"
        class="cursor-pointer w-54.5 h-auto"
      />
    </a>
    <div
      class="flex flex-col items-center lg:items-start justify-center gap-[13px] md:gap-[32px] max-w-[389px]"
    >
      <p class="text-main text-[14px] font-normal leading-[170%] text-center lg:text-start">
        {content?.text}
      </p>
      <div class="flex items-center gap-1.5">
        {
          icons.map((i) => (
            <a
              href={i.href}
              class="w-[31px] h-[31px] rounded-full flex items-center justify-center bg-main flex-shrink-0"
            >
              <Icon name={i.name} class={'w-4 h-4  text-white'} />
            </a>
          ))
        }
      </div>
    </div>
    <div class="flex flex-col items-center lg:items-start justify-center gap-9 lg:gap-[55px]">
      <div class="flex flex-col items-center lg:items-start justify-center gap-2 md:gap-[13px]">
        <p class="text-secondary text-[16px] font-semibold leading-[160%]">
          {content?.hours}
        </p>
        <p class="text-main text-[18px] font-semibold leading-[160%]">
          8:00am - 7:00pm
        </p>
      </div>
      <div class="flex flex-col items-center lg:items-start justify-center gap-2 md:gap-[13px]">
        <p class="text-secondary text-[16px] font-semibold leading-[160%]">
          {content?.call}
        </p>
        <a
          href="tel:+16783086271"
          class="text-center text-[14px] font-bold leading-[160%] text-main"
          >+1 (678) 308-6271</a
        >
      </div>
    </div>
    <div
      class="w-full md:w-auto order-first md:order-last flex flex-col justify-center items-center md:items-end gap-[23px] md:gap-[18px]"
    >
      <p
        class="text-secondary text-[16px] font-semibold leading-[160%] text-right"
      >
        {content?.links_title}
      </p>
      <div
        class="flex flex-col items-center lg:items-end gap-5 w-full md:gap-[26px]"
      >
        {
          content?.links.map((item, index) => {
            const itemPathWithoutHash = item.href.split('#')[0]; // Quitar hash del item
            const isActive =
              normalized === itemPathWithoutHash ||
              (index === 1 && normalized.startsWith('/services'));
            const isServices = index === 1;
            return (
              <div class="relative flex flex-col justify-center items-end">
                {isServices ? (
                  <button
                    class={`services-toggle w-full text-center lg:text-right text-[15px] leading-[20px] uppercase hover:font-bold transition-all duration-300 ease-in-out text-main ${isActive ? 'font-bold' : 'font-medium'} cursor-pointer`}
                    data-services-menu
                    set:html={item.label}
                  />
                ) : (
                  <a
                    href={`/${lang}${item.href}`}
                    class={`w-full text-center lg:text-right text-[14px] leading-[170%] uppercase hover:font-bold transition-all duration-300 ease-in-out text-main ${isActive ? 'font-bold' : 'font-medium'}`}
                    set:html={item.label}
                  />
                )}
                {isServices && (
                  <div class="services-dropdown hidden flex-col items-end justify-center gap-0 bg-accent mt-2 rounded-md shadow-lg overflow-hidden transition-all duration-300 ease-in-out absolute z-[20] top-[15px] w-[190px] md:right-0 md:left-auto left-1/2 md:translate-x-0 -translate-x-1/2">
                    {content?.types.map((subItem) => (
                      <a
                        href={`/${lang}/services/${subItem.href}`}
                        class={`w-full text-center lg:text-right text-[14px] md:text-[15px] leading-[20px] uppercase hover:font-bold transition-all duration-300 ease-in-out text-white py-3 px-10 md:px-4 hover:bg-main`}
                        set:html={subItem.title}
                      />
                    ))}
                  </div>
                )}
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
  <div
    class="w-full bg-[#E5E5E5] py-3.5 md:py-4.5 gap-0 px-5 lg:px-0 flex justify-center items-center"
  >
    <div
      class="flex flex-col lg:flex-row justify-between items-center md:gap-4 lg:gap-7 w-full max-w-screen lg:max-w-7xl"
    >
      <a href="https://inkshapegroup.com/en/">
        <img
          src="/footer-logo.webp"
          alt="Imagen del Footer"
          width="3745"
          height="996"
          class="w-27.5 md:w-34 h-7.25 md:h-9.25 cursor-pointer"
        />
      </a>
      <p
        class="text-[#404040] text-[10px] md:text-[13px] leading-4.25 md:leading-11.5 text-center max-w-76 md:max-w-none"
      >
        Copyright © 2025 by Inkshape Group | Privacy | MG Riox
        Plumbing | Atlanta, Georgia | Call Now:<a
          href="tel:+16783086271"
          class="hover:text-main">+1 (678) 308-6271</a
        >
      </p>
    </div>
  </div>
</footer>
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const servicesToggle = document.querySelector('[data-services-menu]');
    const servicesDropdown = document.querySelector('.services-dropdown');

    if (servicesToggle && servicesDropdown) {
      // Toggle del menu al hacer click
      servicesToggle.addEventListener('click', (e) => {
        e.preventDefault();
        const isOpen = servicesDropdown.classList.contains('flex');

        if (isOpen) {
          // Cerrar menu
          servicesDropdown.classList.remove('flex');
          servicesDropdown.classList.add('hidden');
        } else {
          // Abrir menu
          servicesDropdown.classList.remove('hidden');
          servicesDropdown.classList.add('flex');
        }
      });

      // Cerrar menu al hacer click fuera
      document.addEventListener('click', (e) => {
        if (
          !servicesToggle.contains(e.target) &&
          !servicesDropdown.contains(e.target)
        ) {
          servicesDropdown.classList.remove('flex');
          servicesDropdown.classList.add('hidden');
        }
      });
    }
  });
</script>
