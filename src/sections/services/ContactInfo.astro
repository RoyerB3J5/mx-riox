---
import CarouselServices from '../../components/CarouselServices.astro';

interface Props {
  carouselImages:string[]
}
const { carouselImages } = Astro.props as Props;
---

<section class="flex flex-col lg:flex-row justify-center items-center lg:items-stretch gap-7 pb-10 md:pb-[50px] max-w-screen md:max-w-[1100px] px-4 lg:px-0 w-full min-h-[660px] h-full">
  <div class="flex flex-col justify-around items-center gap-20 w-full max-w-[600px] h-full">
    <CarouselServices images={carouselImages}/>
    <a href="/">
      <img src="/logo-black.webp" alt="Logo de Mg Riox Plumbing" width="1300" height="728" class="cursor-pointer w-[173px] md:w-[500px] h-auto">
    </a>
  </div>
  
  <div class="w-full lg:w-[484px] h-auto">
    <div class="form-container" id="form-Bz8yTCN1XgrIcpTXa573-wrapper" style="min-height:120px;">
      <div class="form-placeholder" style="display:flex;align-items:center;justify-content:center;">
        <small>Cargando formulario…</small>
      </div>
      <iframe
    data-src="https://link.inkshapecrm.com/widget/form/DZ5ZUfR17u8jwJAss7M7"
    style="width:100%;height:100%;border:none;overflow:hidden;display:none;"
    id="inline-DZ5ZUfR17u8jwJAss7M7" 
    data-layout="{'id':'INLINE'}"
    data-trigger-type="alwaysShow"
    data-trigger-value=""
    data-activation-type="alwaysActivated"
    data-activation-value=""
    data-deactivation-type="neverDeactivate"
    data-deactivation-value=""
    data-form-name="Form General Website"
    data-height="778"
    data-layout-iframe-id="inline-DZ5ZUfR17u8jwJAss7M7"
    data-form-id="DZ5ZUfR17u8jwJAss7M7"
    title="Form General Website"
    loading="lazy"
        sandbox="allow-forms allow-scripts allow-popups allow-same-origin"></iframe>
    </div>
  </div>
</section>