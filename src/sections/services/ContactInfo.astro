---
import CarouselServices from '../../components/CarouselServices.astro';
interface Props {
  title: string;
  description: string;
  image: string;
  carouselImages: string[];
}
const { carouselImages, title, description, image } = Astro.props as Props;
---

<section
  class="w-full max-w-screen xl:max-w-7xl px-5 xl:px-0 py-20 sm:py-30 gap-20 sm:gap-30 flex flex-col justify-center items-center bg-[#FAFAFA]"
>
  <div
    class="flex flex-col md:flex-row justify-between items-center gap-10 w-full"
    data-aos="fade-down"
  >
    <div
      class="flex flex-col justify-center items-start w-full md:w-[50%] lg:w-[45%] gap-6"
    >
      <div class="flex flex-col justify-center items-start gap-4">
        <h2
          class="text-main font-title text-[32px] md:text-[56px] font-semibold leading-[135%] md:leading-[115%]"
          set:html={title}
        />

        <p
          class="text-paragraph text-[14px] font-normal leading-[170%]"
          set:html={description}
        />
      </div>
    </div>

    <img
      src={`/main/${image}.webp`}
      alt="Referencia Mg Riox Plumbing"
      width="800"
      height="533"
      class="w-full md:w-[50%] lg:w-[55%] h-auto rounded-lg"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="w-full flex flex-col lg:flex-row justify-center lg:justify-between items-center lg:items-start gap-10 lg:gap-4">
    <div
      class="flex flex-col justify-around items-center gap-20 w-full lg:w-[60%] h-full "
    >
      <CarouselServices images={carouselImages} />
    </div>

    <div class="w-full lg:w-[40%] h-auto bg-white px-6 rounded-lg">
      <div
        class="form-container"
        id="form-Bz8yTCN1XgrIcpTXa573-wrapper"
        style="min-height:120px;"
      >
        <div
          class="form-placeholder"
          style="display:flex;align-items:center;justify-content:center;"
        >
          <small>Cargando formulario…</small>
        </div>
        <iframe
          data-src="https://link.inkshapecrm.com/widget/form/DZ5ZUfR17u8jwJAss7M7"
          style="width:100%;height:100%;border:none;overflow:hidden;display:none;"
          id="inline-DZ5ZUfR17u8jwJAss7M7"
          data-layout="{'id':'INLINE'}"
          data-trigger-type="alwaysShow"
          data-trigger-value=""
          data-activation-type="alwaysActivated"
          data-activation-value=""
          data-deactivation-type="neverDeactivate"
          data-deactivation-value=""
          data-form-name="Form General Website"
          data-height="778"
          data-layout-iframe-id="inline-DZ5ZUfR17u8jwJAss7M7"
          data-form-id="DZ5ZUfR17u8jwJAss7M7"
          title="Form General Website"
          loading="lazy"
          sandbox="allow-forms allow-scripts allow-popups allow-same-origin"
        ></iframe>
      </div>
    </div>
  </div>
</section>
