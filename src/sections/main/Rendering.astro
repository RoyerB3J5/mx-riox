---
import Button from '../../components/Button.astro';

type Translations = typeof import('../../i18n/es').default;
type RenderingContent = Translations['main']['information']['rendering'];
interface Props {
  content: RenderingContent;
}
const { content } = Astro.props as Props;
---

<div
  class="flex flex-col md:flex-row justify-center md:justify-between items-center w-full"
>
  <img
    src="/main/rendering.webp"
    alt="Rendering Mg Riox Plumbing"
    width="1200"
    height="800"
    class="w-full md:w-[50%] h-auto"
    loading="lazy"
    decoding="async"
    data-aos="fade-right"
  />
  <div
    class="flex flex-col justify-center items-start px-5 py-16 md:p-8 lg:p-10 xl:p-16 gap-8 md:gap-4 lg:gap-8 w-full md:w-[50%] bg-main h-full aspect-auto md:aspect-1200/800"
    data-aos="fade-left"
  >
    <div class="flex flex-col justify-center items-start gap-2 lg:gap-4.5">
      <h2
        set:html={content.title}
        class="text-white font-title text-[32px] lg:text-[42px] xl:text-[56px] font-semibold leading-[135%] md:leading-[115%]"
      />
      <p class="text-white text-[14px] font-normal leading-[170%]">
        {content.text}
      </p>
    </div>
    <Button
      class="bg-secondary px-6 py-4 flex items-center text-white"
      href="contact#info"
    >
      {content.button}
    </Button>
  </div>
</div>
