---
type Translations = typeof import('../../i18n/es').default;
type WorkingContent = Translations['main']['information']['working'];
interface Props {
  content: WorkingContent;
}
const { content } = Astro.props as Props;
---

<div class="w-full flex flex-col justify-center items-center gap-16">
  <h2
    class="text-main text-center font-title text-[56px] font-semibold leading-[115%]"
  >
    {content.title}
  </h2>
  <div
    class="w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 justify-center items-center gap-4"
  >
    {
      content.items.map((item, idx) => (
        <div
          class={`flex flex-col justify-between items-start ${item.icon == 'installation' ? 'gap-2.5' : 'gap-8'}  px-5 py-6 rounded-[8px] bg-white shadow-item flex-1 basis-0 min-w-0 h-full min-h-none lg:min-h-[365px] working-item`}
          data-aos="fade-up"
          data-aos-delay={`${idx * 400}`}
        >
          <div class="flex flex-col justify-center items-start gap-6">
            <img
              src={`/main/${item.icon}.svg`}
              alt={item.title}
              width="48"
              height="48"
              class="w-12 h-12"
            />
            <p class="text-secondary font-title text-[16px] font-semibold leading-[160%]">
              {item.step}
            </p>
          </div>
          <h3 class="text-main text-[24px] xl:text-[32px] font-semibold leading-[135%]">
            {item.title}
          </h3>
          <p class="text-paragraph text-[14px] font-normal leading-[170%]">
            {item.description}
          </p>
          <div class="w-14 h-0.5 bg-secondary" />
        </div>
      ))
    }
  </div>
</div>

<script>
  (function () {
    function setEqualHeights() {
      const items = document.querySelectorAll<HTMLElement>('.working-item');
      if (!items.length) return;

      items.forEach((el) => (el.style.height = 'auto'));

      const max = Math.max(...Array.from(items, (el) => el.offsetHeight));

      items.forEach((el) => (el.style.height = max + 'px'));
    }

    /** @type {number} */
    let resizeTimeout: any;

    window.addEventListener('load', setEqualHeights);
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(setEqualHeights, 120);
    });

    const imgs =
      document.querySelectorAll<HTMLImageElement>('.working-item img');
    imgs.forEach((img) => {
      if (!img.complete) {
        img.addEventListener('load', setEqualHeights);
      }
    });

    setTimeout(setEqualHeights, 50);
  })();
</script>
