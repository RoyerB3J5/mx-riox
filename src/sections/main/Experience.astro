---
import { Icon } from 'astro-icon/components';
import BeforeAfter from '../../components/BeforeAfter.astro';

type Translations = typeof import('../../i18n/es').default;
type ExperienceContent = Translations['main']['experience'];
interface Props {
  content: ExperienceContent;
}
const { content } = Astro.props as Props;
---

<section class="w-full flex flex-col justify-center items-center gap-10 sm:gap-4">
  <div
    class="w-full flex flex-col md:flex-row items-center md:items-start justify-center gap-4"
  >
    <div
      class="grid grid-cols-1 lg:grid-cols-2 grid-rows-3 sm:grid-rows-4 gap-4 w-full max-w-none sm:max-w-[50%] lg:max-w-[70%] h-full min-h-[638px]"
      data-aos="fade-right"
    >
      <div
        class="col-start-1 row-start-1 row-span-2 rounded-[8px] lg:flex items-center justify-center relative overflow-hidden hidden"
      >
        <img
          src="/main/exp-2.webp"
          alt="Experiencia 2 MG Riox"
          loading="lazy"
          decoding="async"
          width="700"
          height="446"
          class="w-full h-full inset-0 absolute object-cover"
        />
      </div>
      <div
        class="col-start-1 row-start-3 row-span-2 rounded-[8px] hidden lg:flex items-center justify-center relative overflow-hidden"
      >
        <img
          src="/main/exp-1.webp"
          alt="Experiencia 1 MG Riox"
          loading="lazy"
          decoding="async"
          width="700"
          height="446"
          class="w-full h-full inset-0 absolute object-cover"
        />
      </div>
      <div
        class="col-start-1 lg:col-start-2 row-start-1 row-span-3 rounded-[8px] flex items-center justify-center relative overflow-hidden"
      >
        <img
          src="/main/exp-3.webp"
          alt="Experiencia 3 MG Riox"
          loading="lazy"
          decoding="async"
          width="1350"
          height="900"
          class="w-full h-full inset-0 absolute object-cover"
        />
      </div>
      <div
        class="col-start-1 lg:col-start-2 row-start-4 bg-main text-white px-8 sm:flex items-center gap-4 justify-center box-border border-l-[9px] border-secondary hidden"
      >
        <p class="text-[#FAFAFA] text-[72px] font-bold leading-[115%]">30+</p>
        <p
          class="text-[#FAFAFA] text-[24px] uppercase font-medium leading-[140%]"
        >
          {content.years}
        </p>
      </div>
    </div>
    <div
      class="flex flex-col items-start justify-center max-w-none sm:max-w-[50%] lg:max-w-[30%] gap-6"
      data-aos="fade-left"
    >
      <div class="flex flex-col justify-center items-start gap-4">
        <div
          class="flex flex-col justify-center items-start text-main font-title text-[32px] sm:text-[56px] leading-[135%] sm:leading-[115%] font-semibold"
        >
          <h2>The MG Riox</h2>
          <p>Difference</p>
        </div>
        <p
          class="text-[18px] leading-[160%] font-semibold text-secondary max-w-[80%]"
          set:html={content.description}
        />
      </div>
      <p
        set:html={content.description2}
        class="text-paragraph text-[14px] font-normal leading-[170%]"
      />
      <div
        class="flex flex-col md:flex-row justify-center items-center md:items-start gap-6"
      >
        <div
          class="flex flex-col justify-center items-center md:items-start gap-6 w-full"
        >
          <div class="flex flex-col gap-6">
            {
              content.items.map((item) => (
                <div class="flex items-center gap-4">
                  <Icon
                    name={'check'}
                    class={
                      'shrink-0 h-[20px] md:h-[44px] w-[20px] md:w-[44px] text-secondary'
                    }
                  />
                  <p class="text-[14px] font-semibold leading-[170%] text-[#1F2933]">
                    {item}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
  <div
    class="col-start-1 lg:col-start-2 row-start-4 bg-main text-white px-8 flex items-center gap-4 justify-center box-border border-l-[9px] border-secondary sm:hidden py-8"
  >
    <p class="text-[#FAFAFA] text-[72px] font-bold leading-[115%]">30+</p>
    <p class="text-[#FAFAFA] text-[24px] uppercase font-medium leading-[140%]">
      {content.years}
    </p>
  </div>
  <div
    class="flex flex-col md:flex-row justify-center items-center gap-4 w-full"
  >
    <BeforeAfter
      beforeImage="/main/before-1-2.webp"
      afterImage="/main/before-1-1.webp"
    />
    <BeforeAfter
      beforeImage="/main/before-2-2.webp"
      afterImage="/main/before-2-1.webp"
    />
  </div>
</section>
