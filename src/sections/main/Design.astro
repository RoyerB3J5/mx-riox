---
import FormRefered1 from '../../components/FormRefered1.astro';

type Translations = typeof import('../../i18n/es').default;
type DesignContent = Translations['main']['information']['design'];
interface Props {
  content: DesignContent;
}
const { content } = Astro.props as Props;
---

<div
  class="flex flex-col lg:flex-row justify-center items-center gap-10 md:gap-16 w-full overflow-hidden "
>
  <div
    class="w-full lg:w-[50%] flex flex-col justify-center items-center gap-6"
  >
    <div class="flex flex-col justify-center items-center lg:items-start gap-4">
      <h2
        set:html={content.title}
        class="text-main font-title text-[56px] font-semibold leading-[115%]"
      />
      <p class="text-paragraph text-[14px] font-normal leading-[170%]">
        {content.description}
      </p>
    </div>
    <div
      class="relative w-full h-63.5 md:h-133.5 rounded-lg overflow-hidden block"
    >
      <img
        src="/main/design.webp"
        alt="Experiencia 3"
        width="900"
        height="600"
        class="absolute inset-0 h-full w-full object-cover"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
  <div class="w-full lg:w-[50%] max-w-full shrink-0 overflow-hidden">
    <FormRefered1 />
  </div>
</div>
