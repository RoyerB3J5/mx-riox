---
import Button from '../../components/Button.astro';
import { MuxPlayer } from '@mux/mux-player-astro';

type Translations = typeof import('../../i18n/es').default;
type HeroContent = Translations['main']['hero'];
interface Props {
  content: HeroContent;
}
const { content } = Astro.props as Props;
---

<section class="w-full flex items-center justify-center relative">
  <img
    src="/main/hero.webp"
    alt="Fondo de soluciones"
    width="1440"
    height="900"
    class="absolute inset-0 w-auto md:w-full h-full object-cover -z-20 md:object-center hidden md:block"
    loading="eager"
    decoding="async"
  />
  <img
    src="/main/hero-main-sm.webp"
    alt="Fondo de soluciones"
    width="375"
    height="900"
    class="absolute inset-0 w-full h-full object-cover -z-20 md:hidden block object-center"
    loading="eager"
    decoding="async"
  />
  <div
    class="w-full max-w-screen md:max-w-7xl flex flex-row justify-start items-start sm:items-center lg:items-end gap-4 md:gap-[80px] px-5 xl:px-0 h-dvh md:h-[55vh] lg:h-[100vh] 3xl:h-[95vh] pt-33 md:pt-0 pb-0 lg:pb-4 3xl:pb-15"
    data-aos="fade-up"
    data-aos-duration="2000"
  >
    <div
      class="flex flex-col items-start justify-center w-full max-w-none sm:max-w-[50%] gap-3 3xl:gap-6 translate-y-10 lg:translate-y-0"
    >
      <MuxPlayer
        playbackId={content.video}
        metadata={{
          video_title: 'MG RIOX PLUMBING',
        }}
        accentColor="#c60500"
        class="w-full aspect-video sm:w-[80%] lg:w-full max-w-[450px] 3xl:max-w-[550px] rounded-lg overflow-hidden bg-transparent hidden md:block"
        poster="https://image.mux.com/yciyc7Zh00T7wQ00M200Ma0057bhXLHnPVlmVvSgTbRkqzI/thumbnail.png?time=0"
      />
      <h1
        class="font-title text-[32px] sm:text-[28px] lg:text-[40px] leading-[135%] sm:leading-[120%] font-semibold text-main"
        set:html={content.title}
      />
      <img
        src="/main/google.webp"
        alt="Icono de Google"
        width="500"
        height="281"
        class="h-[86px] md:h-[60px] lg:h-[70px] 3xl:h-[86px] w-auto"
      />
      <div
        class="flex flex-col md:flex-row justify-center items-start md:items-center gap-[18px] w-full md:w-auto relative z-[20]"
      >
        <Button class="bg-secondary w-auto text-white" href="tel:+16783086271">
          {content.button1}
        </Button>
        <Button class="bg-white w-auto text-secondary" href="contact#info">
          {content.button2}
        </Button>
      </div>
    </div>
  </div>
</section>
