---
import '../../styles/global.css';
import { CiFacebook, CiInstagram } from 'react-icons/ci';
import Starts from '../../components/Starts';
import LayoutSec from '../../layouts/LayoutSec.astro';
---

<LayoutSec>
  <section
    class="w-full flex flex-col justify-center items-center gap-4 h-full py-10"
  >
    <div
      class="w-full flex flex-col justify-center items-center gap-4 min-h-[60vh] text-white"
    >
      <div class="w-full flex flex-col justify-center items-center gap-[20px]">
        <a
          href="/"
          aria-label="Ir a la página principal"
          title="Inicio Mg Riox Plumbing"
        >
          <img
            src="/logo.webp"
            alt="Logo de Mg Riox Plumbing - Servicio en Atlanta, Georgia"
            width="700"
            height="133"
            class="cursor-pointer w-[350px] h-auto"
          />
        </a>
        <div class="flex flex-col justify-center items-center">
          <p
            class="font-heveltica text-[16px] leading-[22px] max-w-[330px] text-center"
          >
            MG Riox Plumbing: Professional plumbing company based in Atlanta,
            Georgia
          </p>
        </div>
      </div>
      <div
        class="bg-secondary rounded-[15px] w-full text-white flex flex-col justify-center items-center gap-4 py-5 max-w-[500px]"
      >
        <p class="text-[16px] font-medium text-center">
          Please tap the option that best <br />Reflects the quality of our
          service
        </p>
        <Starts client:idle />
      </div>
    </div>

    <section
      class="flex flex-col justify-center items-center gap-3 w-full pt-8 bottom-0"
    >
      <div class="flex justify-center items-center gap-3">
        <a href="https://www.facebook.com/mgrioxplumbing/" target="_blank">
          <CiFacebook className="size-8 sm:size-7 text-white" />
        </a>
        <a href="https://www.instagram.com/mgrioxplumbing/">
          <CiInstagram className="size-8 sm:size-7 text-white" />
        </a>
      </div>
      <div class="flex flex-col justify-center items-center gap-[9px]">
        <p class="text-[12px] font-normal leading-[140%] text-white">
          Powered by
        </p>
        <a href="https://inkshapegroup.com/en/">
          <img
            src="/footer-logo.webp"
            alt="Imagen del Footer"
            width="3745"
            height="996"
            class="w-[110px] h-[29px] cursor-pointer"
          />
        </a>
      </div>
    </section>
  </section>
</LayoutSec>
