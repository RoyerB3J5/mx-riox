---
import { Icon } from 'astro-icon/components';
import en from '../../../i18n/en';
import es from '../../../i18n/es';
import Layout from '../../../layouts/Layout.astro';
import Project from '../../../sections/main/Project.astro';
import type { Language } from '../../../types/language.type';
export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}
export const defaultRedirect = '/en';

const lang = Astro.params.lang as Language;
const translations = { es, en };
const t = translations[lang];
---

<Layout lang={lang} t={t}>
  <section class="w-full flex items-center justify-center relative">
    <img
      src={`/main/bg-contact.webp`}
      alt="Fondo de soluciones"
      width="1440"
      height="900"
      class={`absolute inset-0 w-auto md:w-full h-full object-cover -z-20 object-[65%_50%] md:object-center`}
      loading="eager"
      decoding="async"
    />
    <div
      class="w-full max-w-screen md:max-w-7xl flex flex-row justify-start items-center gap-4 md:gap-20 px-5 xl:px-0 h-dvh md:h-[55vh] lg:h-screen 3xl:h-[85vh] pt-0"
      data-aos="fade-up"
      data-aos-duration="2000"
    >
      <div
        class={`flex flex-col max-w-[50%] md:max-w-none justify-center items-start gap-4 `}
      >
        <h1
          class="text-white font-title text-[64px] md:text-[128px] font-semibold leading-[115%]"
          set:html={t.contact.title}
        />
      </div>
    </div>
  </section>
  <section
    class="w-full max-w-screen xl:max-w-7xl px-5 xl:px-0 py-20 sm:py-30 flex flex-col lg:flex-row gap-10 lg:gap-4 justify-center items-start"
    data-aos="zoom-in-down"
    data-aos-offset="200"
    id="info"
  >
    <div
      class="w-full lg:w-[60%] flex flex-col justify-center items-start gap-12"
    >
      <div class="flex flex-col justify-center items-start gap-16">
        <div
          class="flex flex-col justify-center items-center md:items-start gap-4 w-full"
        >
          <h2
            class="text-main font-title text-[56px] font-semibold leading-[115%]"
          >
            {t.contact.text}
          </h2>
          <p class="text-paragraph text-[16px] font-normal leading-[157%]">
            {t.contact.description}
          </p>
        </div>
        <div class="flex flex-col justify-center items-start gap-6">
          {
            t.contact.items.map((item) => (
              <div class="flex justify-start items-center gap-4">
                <img
                  src={`/icon/${item.icon}.svg`}
                  alt={item.label}
                  width="40"
                  height="40"
                  class="w-10 h-10"
                />
                <a
                  href={item.href}
                  class="text-main text-[18px] font-semibold leading-[160%] cursor-pointer"
                >
                  {item.label}
                </a>
              </div>
            ))
          }
        </div>
      </div>
      <div
        class="w-full aspect-759/575 h-auto rounded-lg overflow-hidden relative"
      >
        <img
          src="/main/contact-1.webp"
          alt="Experiencia MgRiox Plumbing"
          width="800"
          height="533"
          class="w-full h-full inset-0 absolute object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <div class="w-full lg:w-[40%] px-6 bg-white rounded-lg">
      <div
        class="form-container"
        id="form-Bz8yTCN1XgrIcpTXa573-wrapper"
        style="min-height:120px;"
      >
        <div
          class="form-placeholder"
          style="display:flex;align-items:center;justify-content:center;"
        >
          <small>Cargando formulario…</small>
        </div>
        <iframe
          data-src="https://link.inkshapecrm.com/widget/form/DZ5ZUfR17u8jwJAss7M7"
          style="width:100%;height:100%;border:none;border-radius:3px;overflow:hidden;display:none;"
          id="inline-DZ5ZUfR17u8jwJAss7M7"
          data-layout="{'id':'INLINE'}"
          data-trigger-type="alwaysShow"
          data-trigger-value=""
          data-activation-type="alwaysActivated"
          data-activation-value=""
          data-deactivation-type="neverDeactivate"
          data-deactivation-value=""
          data-form-name="Form General Website"
          data-height="778"
          data-layout-iframe-id="inline-DZ5ZUfR17u8jwJAss7M7"
          data-form-id="DZ5ZUfR17u8jwJAss7M7"
          title="Form General Website"
          loading="lazy"
          sandbox="allow-forms allow-scripts allow-popups allow-same-origin"
        >
        </iframe>
      </div>
    </div>
  </section>
  <Project content={t.contact.project} />
</Layout>
