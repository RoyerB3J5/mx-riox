---
import { Icon } from 'astro-icon/components';
import CarouselReviewAbout from '../../../components/CarouselReviewAbout.astro';
import en from '../../../i18n/en';
import es from '../../../i18n/es';
import Layout from '../../../layouts/Layout.astro';
import Project from '../../../sections/main/Project.astro';
import type { Language } from '../../../types/language.type';
export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}
export const defaultRedirect = '/en';

const lang = Astro.params.lang as Language;
const translations = { es, en };
const t = translations[lang];
---

<Layout lang={lang} t={t}>
  <section class="w-full flex items-center justify-center relative">
    <img
      src={`/main/bg-us.webp`}
      alt="Fondo de soluciones"
      width="1440"
      height="900"
      class={`absolute inset-0 w-auto md:w-full h-full object-cover -z-20 object-[55%_50%] md:object-center`}
      loading="eager"
      decoding="async"
    />
    <div
      class="w-full max-w-screen md:max-w-7xl flex flex-row justify-start items-center gap-4 md:gap-20 px-5 xl:px-0 h-dvh md:h-[55vh] lg:h-screen 3xl:h-[85vh] pt-0"
      data-aos="fade-up"
      data-aos-duration="2000"
    >
      <div
        class={`flex flex-col max-w-[50%] md:max-w-none justify-center items-start gap-4 `}
      >
        <h1
          class="text-main font-title text-[64px] md:text-[128px] font-semibold leading-[115%]"
          set:html={t['about-us'].title}
        />
      </div>
    </div>
  </section>
  <section
    class="w-full flex flex-col justify-center items-center gap-20 lg:gap-40 py-20 lg:py-40 max-w-screen xl:max-w-7xl px-5 xl:px-0"
  >
    <div
      class="w-full flex flex-col md:flex-row jutify-center md:justify-between items-center gap-10 md:gap-0"
      data-aos="zoom-out-up"
      data-aos-offset="200"
    >
      <a href="/">
        <img
          src="/logo-black.webp"
          alt="Logo de Mg Riox Plumbing"
          width="1300"
          height="728"
          class="cursor-pointer w-full h-auto max-w-106.75"
        />
      </a>
      <p
        class="text-paragraph text-[16px] font-normal leading-[157%] w-full md:w-[60%]"
        set:html={t['about-us'].description}
      />
    </div>
    <div
      class="w-full bg-white rounded-lg min-h-75 flex flex-col lg:flex-row justify-center items-center px-2 sm:px-4 lg:px-16 gap-8 py-10 lg:py-0"
    >
      <div class="flex flex-col justify-center items-center gap-3 w-70">
        <p class="text-[24px] font-bold">{t.main.numbers.text}</p>
        <div class="flex justify-center items-center gap-1">
          {
            Array.from({ length: 5 }, (_) => (
              <img
                src="/star.svg"
                alt="Estrellas"
                width="30"
                height="30"
                class="w-7.5 h-7.5"
                loading="lazy"
                decoding="async"
              />
            ))
          }
        </div>
        <p set:html={t.main.numbers.description} class="text-[15px]" />
        <img
          src="/main/google.png"
          alt="Icono de Google"
          width="97px"
          height="54px"
          class="h-17.25 md:h-8.75 w-auto"
        />
      </div>
      <CarouselReviewAbout />
    </div>
    <div
      class="w-full flex flex-col md:flex-row justify-center items-center gap-10 md:gap-16"
    >
      <div
        class="flex flex-col justify-center items-start gap-4 w-full md:w-[50%]"
        data-aos="fade-down"
      >
        <h2
          class="text-main font-title text-[56px] font-semibold leading-[115%]"
        >
          {t['about-us'].team.title}
        </h2>
        <p
          class="text-paragraph text-[14px] font-normal leading-[170%]"
          set:html={t['about-us'].team.description}
        />
      </div>
      <div
        class="relative w-full md:w-[50%] h-auto aspect-648/372 o rounded-lg overflow-hidden"
        data-aos="fade-up"
      >
        <img
          src="/main/about-us.webp"
          alt="Patios MgRioxPlumbing"
          width="648"
          height="372"
          class="w-full h-full inset-0 absolute object-cover object-[50%_70%]"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
    <div class="w-full flex flex-col justify-center items-center gap-16">
      <h2
        set:html={t['about-us'].stand.title}
        class="text-[40px] font-normal text-center leading-[115%] font-title text-black"
      />
      <div
        class="w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 justify-center items-center gap-4"
      >
        {
          t['about-us'].stand.list.map((item, idx) => (
            <div
              class={`flex flex-col justify-start items-start p-6 rounded-lg bg-white shadow-item flex-1 basis-0 min-w-0 h-full min-h-none lg:min-h-87.25 working-item gap-8`}
              data-aos="fade-up"
              data-aos-delay={`${idx * 300}`}
            >
              <div class="flex flex-col justify-center items-start gap-6">
                <p class="text-secondary font-title text-[56px] font-semibold leading-[115%]">
                  {item.letter}
                </p>
              </div>
              <div class="flex flex-col justify-between items-start h-full gap-8 lg:gap-0">
                <div class="flex flex-col justify-center items-start gap-4">
                  <h3 class="text-main text-[18px] font-semibold leading-[160%]">
                    {item.title}
                  </h3>
                  <p class="text-paragraph text-[14px] font-normal leading-[170%]">
                    {item.description}
                  </p>
                </div>
                <div class="w-14 h-0.5 bg-secondary" />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <Project content={t['about-us'].project} />
</Layout>
